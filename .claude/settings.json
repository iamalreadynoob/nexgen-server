{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run pre-commit run:*)",
      "Bash(uv tree:*)",
      "Bash(uv pip list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Edit(./requirements.txt)",
      "Edit(./uv.lock)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(grep:* .env)",
      "Bash(source .env)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(docker compose config)",
      "Bash(docker compose config:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
